{
  "name": "toolhub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "npm run collect -w @toolhub/collector --",
    "brief": "npm run --silent brief -w @toolhub/collector --",
    "web": "npm run dev -w @toolhub/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/web/lib/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
