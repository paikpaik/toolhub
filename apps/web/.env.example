# 이 파일을 .env.local로 복사한 뒤 값을 채운다 (.env.local은 git에 올라가지 않는다)
# 발급: searchad.naver.com > 도구 > API 사용 관리

# 액세스 라이선스
NAVER_SEARCHAD_API_KEY=
# 비밀키
NAVER_SEARCHAD_SECRET_KEY=
# CUSTOMER_ID
NAVER_SEARCHAD_CUSTOMER_ID=

# NAVER API HUB (검색어 트렌드·쇼핑 인사이트·블로그/지식iN/뉴스/카페/지역 검색)
# 발급: 네이버 클라우드 콘솔 > NAVER API HUB > Application > API 관리 > 인증 정보
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
